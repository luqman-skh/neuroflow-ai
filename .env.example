# NeuroFlow AI Configuration Example

# LLM Provider Configuration
# Options: "fake" (deterministic offline planning & testing), "ollama" (local open-weight), "openai", "anthropic"
LLM_PROVIDER=fake
LLM_MODEL=mock-model
LLM_TEMPERATURE=0.0
OLLAMA_BASE_URL=http://localhost:11434

# Cloud Provider API Keys (leave empty for fake or ollama)
OPENAI_API_KEY=
ANTHROPIC_API_KEY=

# Persistence Database Path
SQLITE_DB_PATH=data/neuroflow.db

# Gradio Web Interface (0.0.0.0 for Docker containers, 127.0.0.1 for local host)
GRADIO_SERVER_NAME=127.0.0.1
GRADIO_SERVER_PORT=7860
